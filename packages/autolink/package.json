{
  "name": "@khoralabs/memories-autolink",
  "version": "0.1.0",
  "description": "Search-then-link graph integration for memories.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoralabs/memories.git",
    "directory": "packages/autolink"
  },
  "homepage": "https://github.com/khoralabs/memories/tree/main/packages/autolink#readme",
  "bugs": "https://github.com/khoralabs/memories/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./workflows": {
      "types": "./src/workflows/index.ts",
      "import": "./src/workflows/index.ts",
      "default": "./src/workflows/index.ts"
    }
  },
  "dependencies": {
    "@khoralabs/memories-core": "workspace:*",
    "@khoralabs/memories-ontologies": "workspace:*",
    "workflow": "^4.5.0"
  },
  "scripts": {
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test src/planner.test.ts src/session.test.ts src/integrate.test.ts",
    "test:integration": "bun --bun ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@workflow/vitest": "^4.0.12",
    "@workflow/world-local": "^4.2.1",
    "undici": "^7.28.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
