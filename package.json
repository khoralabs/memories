{
  "name": "@khoralabs/memories",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "biome": "biome check .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "tsc --noEmit -p packages/node/tsconfig.json && tsc --noEmit -p packages/otel/tsconfig.json && tsc --noEmit -p packages/service/tsconfig.json && tsc --noEmit -p packages/agents/tsconfig.json && tsc --noEmit -p packages/react/graph/tsconfig.json",
    "assert:no-bun-sqlite-leak": "bun run scripts/assert-no-bun-sqlite-leak.ts",
    "assert:storage-entry-isolation": "bun run scripts/assert-storage-entry-isolation.ts",
    "assert:react-graph-browser-entry": "bun run scripts/assert-react-graph-browser-entry.ts",
    "build": "bun run scripts/build-packages.ts",
    "release:bump": "bun run scripts/bump-versions.ts",
    "release:refresh-lockfile": "bun run scripts/refresh-workspace-lockfile.ts",
    "release:verify-pack": "bun run scripts/verify-packed-workspace-deps.ts",
    "release:publish": "bun run scripts/publish-packages.ts",
    "test": "bun test",
    "prepare": "husky",
    "context": "bun run scripts/context.ts",
    "agent-review": "agent-review",
    "review": "agent-review run --scope staged --include-workstream"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@khoralabs/agent-review": "0.1.1",
    "@types/bun": "latest",
    "@types/parse-gitignore": "^1.0.2",
    "husky": "^9.1.7",
    "minimatch": "^10.2.5",
    "parse-gitignore": "^2.0.0",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "workspaces": [
    "packages/*",
    "packages/**/*"
  ]
}
